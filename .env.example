# Optional shared operator token. Leave unset only for localhost development.
# For remote deployments, use HTTPS + a proper authentication gateway.
RG_API_TOKEN=

# Local paths; datasets are not included in the release.
RG_DATA_ROOT=./data
RG_WEIGHTS=./outputs/best.pt
RG_DB_PATH=./outputs/app.db
RG_MAX_UPLOAD_BYTES=20000000
RG_MAX_IMAGE_PIXELS=40000000
